{
  "name": "leo-tree",
  "version": "1.0.0-beta.4",
  "private": true,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js dev",
    "build": "node --env-file-if-exists=.env.local node_modules/vite/bin/vite.js build",
    "db:migrate": "node scripts/migrate.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:product && npm run test:platform",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:product": "node scripts/product-tests.mjs",
    "test:platform": "node scripts/platform-tests.mjs",
    "test:browser:data": "node --experimental-strip-types scripts/rc-data-browser.mjs",
    "test:browser:learning": "node --experimental-strip-types scripts/rc-learning-browser.mjs",
    "test:browser:production": "node --experimental-strip-types scripts/rc-production.mjs",
    "test:build": "node scripts/verify-build.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "setup:account": "node scripts/setup-local-account.mjs",
    "test:browser:beta": "node scripts/beta-browser.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@radix-ui/react-popover": "^1.1.15",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-plugin": "^1.168.0",
    "better-auth": "~1.6.30",
    "fflate": "^0.8.3",
    "katex": "^0.18.7",
    "kysely": "^0.28.5",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0"
  }
}
