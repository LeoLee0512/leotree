[Unit]
Description=Leo Tree Public Beta
After=network.target

[Service]
Type=simple
User=leotree
Group=leotree
WorkingDirectory=/opt/leotree/current
EnvironmentFile=/etc/leotree.env
# /opt/leotree/node is a symlink to the installed Node.js release directory.
ExecStart=/opt/leotree/node/bin/node /opt/leotree/current/server/index.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/leotree
UMask=0077

[Install]
WantedBy=multi-user.target
